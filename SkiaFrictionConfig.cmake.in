# SkiaFrictionConfig.cmake

get_filename_component(SkiaFriction_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(SkiaFriction_INSTALL_PREFIX "${SkiaFriction_CMAKE_DIR}/../../.." ABSOLUTE)

set(SkiaFriction_INCLUDE_DIRS "${SkiaFriction_INSTALL_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@/skia-friction")
set(_SkiaFriction_LIBDIR "${SkiaFriction_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@")

if(APPLE)
    set(SkiaFriction_LIBRARIES "${_SkiaFriction_LIBDIR}/libskia-friction.@PROJECT_VERSION_MAJOR@.dylib")
elseif(WIN32)
    if(EXISTS "${_SkiaFriction_LIBDIR}/skia-friction.lib")
        set(SkiaFriction_LIBRARIES "${_SkiaFriction_LIBDIR}/skia-friction.lib")
        set(_SkiaFriction_DLL "${SkiaFriction_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/skia-friction.dll")
    else()
        set(SkiaFriction_LIBRARIES "${_SkiaFriction_LIBDIR}/skia.lib")
        set(_SkiaFriction_DLL "${SkiaFriction_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/skia.dll")
    endif()
    if(NOT EXISTS "${_SkiaFriction_DLL}")
        string(REPLACE "/@CMAKE_INSTALL_BINDIR@/" "/@CMAKE_INSTALL_LIBDIR@/" _SkiaFriction_DLL "${_SkiaFriction_DLL}")
    endif()
else()
    set(SkiaFriction_LIBRARIES "${_SkiaFriction_LIBDIR}/libskia-friction.so.@PROJECT_VERSION_MAJOR@")
endif()

if(NOT TARGET SkiaFriction::SkiaFriction)
    add_library(SkiaFriction::SkiaFriction SHARED IMPORTED)
    set_target_properties(SkiaFriction::SkiaFriction PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${SkiaFriction_INCLUDE_DIRS}"
    )

    if(WIN32)
        set_target_properties(SkiaFriction::SkiaFriction PROPERTIES
            IMPORTED_IMPLIB "${SkiaFriction_LIBRARIES}"
            IMPORTED_LOCATION "${_SkiaFriction_DLL}"
            INTERFACE_LINK_LIBRARIES "user32;opengl32"
            INTERFACE_COMPILE_DEFINITIONS "SKIA_DLL"
        )
    else()
        set_target_properties(SkiaFriction::SkiaFriction PROPERTIES
            IMPORTED_LOCATION "${SkiaFriction_LIBRARIES}"
        )
        if(APPLE)
            set_target_properties(SkiaFriction::SkiaFriction PROPERTIES
                IMPORTED_SONAME "@rpath/libskia-friction.@PROJECT_VERSION_MAJOR@.dylib"
                INTERFACE_LINK_LIBRARIES "z"
            )
        else()
            set_target_properties(SkiaFriction::SkiaFriction PROPERTIES
                IMPORTED_SONAME "libskia-friction.so.@PROJECT_VERSION_MAJOR@"
            )
        endif()
    endif()
endif()

unset(_SkiaFriction_LIBDIR)
unset(_SkiaFriction_DLL)
